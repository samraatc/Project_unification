# Copy to .env for local dev. Real secrets live in Vault / AWS Secrets Manager (TRD §5).

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Storefront
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SENTRY_DSN=

# Mongo (docker-compose.dev.yml — replica set required for transactions)
MONGO_URI=mongodb://localhost:27017/unified?replicaSet=rs0&directConnection=true

# Redis (docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=unified-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# JWT (generate via: openssl genrsa 2048 → openssl rsa -pubout)
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# Observability
SENTRY_DSN=
DATADOG_API_KEY=

# Payments (sandbox creds — fill at the start of Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
