{
  "name": "@unified/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Platform REST API — Express + Mongoose + Pino + Zod + JWT.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --clean --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx src/openapi/generate.ts > openapi.generated.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.2",
    "@unified/shared-types": "workspace:*",
    "argon2": "^0.40.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.10",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.14",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@unified/eslint-config": "workspace:*",
    "@unified/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.2.4",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
