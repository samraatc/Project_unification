{
  "$schema": "https://design-tokens.org/format/",
  "color": {
    "brand": {
      "primary": { "$value": "#6366F1", "$type": "color" },
      "primaryHover": { "$value": "#4F46E5", "$type": "color" },
      "secondary": { "$value": "#14B8A6", "$type": "color" },
      "accent": { "$value": "#F59E0B", "$type": "color" }
    },
    "surface": {
      "bg": { "$value": "#E8ECF3", "$type": "color" },
      "raised": { "$value": "#ECF0F7", "$type": "color" },
      "sunken": { "$value": "#DDE3EE", "$type": "color" },
      "shadowLight": { "$value": "#FFFFFF", "$type": "color" },
      "shadowDark": { "$value": "#C8CFDB", "$type": "color" }
    },
    "surfaceDark": {
      "bg": { "$value": "#1E2230", "$type": "color" },
      "raised": { "$value": "#232838", "$type": "color" },
      "sunken": { "$value": "#181C28", "$type": "color" },
      "shadowLight": { "$value": "#2A3042", "$type": "color" },
      "shadowDark": { "$value": "#12141C", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#0F172A", "$type": "color" },
      "secondary": { "$value": "#475569", "$type": "color" },
      "muted": { "$value": "#94A3B8", "$type": "color" },
      "inverse": { "$value": "#F8FAFC", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#10B981", "$type": "color" },
      "warning": { "$value": "#F59E0B", "$type": "color" },
      "error": { "$value": "#EF4444", "$type": "color" },
      "info": { "$value": "#3B82F6", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "'Cabinet Grotesk', 'Inter', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "$type": "dimension" },
      "6xl": { "$value": "3.75rem", "$type": "dimension" }
    }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "14px", "$type": "dimension" },
    "lg": { "$value": "22px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "neuRaised": {
      "$value": "9px 9px 18px #C8CFDB, -9px -9px 18px #FFFFFF",
      "$type": "shadow"
    },
    "neuSunken": {
      "$value": "inset 6px 6px 12px #C8CFDB, inset -6px -6px 12px #FFFFFF",
      "$type": "shadow"
    },
    "neuSoft": {
      "$value": "4px 4px 8px #C8CFDB, -4px -4px 8px #FFFFFF",
      "$type": "shadow"
    },
    "neuHover": {
      "$value": "14px 14px 28px #C8CFDB, -14px -14px 28px #FFFFFF",
      "$type": "shadow"
    }
  }
}
