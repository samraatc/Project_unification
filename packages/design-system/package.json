{
  "name": "@unified/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Neumorphic component library + design tokens. Storybook-driven.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./design-tokens/tokens.json",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./globals.css": "./src/globals.css"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node ./design-tokens/build.cjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.2.9",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/nextjs": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@storybook/test-runner": "^0.19.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@unified/eslint-config": "workspace:*",
    "@unified/motion": "workspace:*",
    "@unified/tsconfig": "workspace:*",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.0.1",
    "eslint": "^8.57.0",
    "framer-motion": "^11.3.24",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.2.9",
    "style-dictionary": "^4.0.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
