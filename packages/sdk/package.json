{
  "name": "@unified/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK generated from apps/api/openapi.json.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o ./src/generated/schema.d.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.0"
  },
  "devDependencies": {
    "@unified/eslint-config": "workspace:*",
    "@unified/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.3.0",
    "typescript": "^5.5.4"
  }
}
