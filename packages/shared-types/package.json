{
  "name": "@unified/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-app TS types + Zod schemas. Source of truth for API request/response shapes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@unified/eslint-config": "workspace:*",
    "@unified/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
