{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@unified/design-system": ["./packages/design-system/src"],
      "@unified/design-system/*": ["./packages/design-system/src/*"],
      "@unified/motion": ["./packages/motion/src"],
      "@unified/motion/*": ["./packages/motion/src/*"],
      "@unified/shared-types": ["./packages/shared-types/src"],
      "@unified/shared-types/*": ["./packages/shared-types/src/*"],
      "@unified/ui-hooks": ["./packages/ui-hooks/src"],
      "@unified/ui-hooks/*": ["./packages/ui-hooks/src/*"],
      "@unified/sdk": ["./packages/sdk/src"],
      "@unified/sdk/*": ["./packages/sdk/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "coverage"]
}
