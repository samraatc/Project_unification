{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".env",
    ".env.development",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "API_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "MONGO_URI",
    "REDIS_URL",
    "JWT_PUBLIC_KEY",
    "JWT_PRIVATE_KEY",
    "SENTRY_DSN",
    "DATADOG_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
